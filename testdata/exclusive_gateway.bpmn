<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="http://example.com/exclusive">
  <process id="proc-exclusive" name="Exclusive Gateway Test" isExecutable="true">
    <startEvent id="start-1" name="Start"/>
    <exclusiveGateway id="gw-1" name="Decision" default="flow-reject">
      <extensionElements>
        <condition flow="flow-approve">amount &lt;= 1000</condition>
      </extensionElements>
    </exclusiveGateway>
    <userTask id="task-approve" name="Auto Approve" assignee="system"/>
    <userTask id="task-reject" name="Manual Review" assignee="manager"/>
    <endEvent id="end-approve" name="Approved"/>
    <endEvent id="end-reject" name="Rejected"/>
    <sequenceFlow id="flow-1" sourceRef="start-1" targetRef="gw-1"/>
    <sequenceFlow id="flow-approve" sourceRef="gw-1" targetRef="task-approve"/>
    <sequenceFlow id="flow-reject" sourceRef="gw-1" targetRef="task-reject"/>
    <sequenceFlow id="flow-2a" sourceRef="task-approve" targetRef="end-approve"/>
    <sequenceFlow id="flow-2b" sourceRef="task-reject" targetRef="end-reject"/>
  </process>
</definitions>
