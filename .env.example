# Database connection string
# Format: postgres://user:password@host:port/dbname?sslmode=disable
DATABASE_URL=postgres://postgres:changeme@db:5432/bpmn?sslmode=disable

# PostgreSQL password (used by docker-compose)
POSTGRES_PASSWORD=changeme

# Logging configuration
LOG_LEVEL=info
LOG_FORMAT=json

AUDIT_LOG_ENABLED=true
AUDIT_LOG_FILE_PATH=./data/audit.jsonl

# AI Provider Configuration
# Supported providers: openai, anthropic
AI_PROVIDER=openai
AI_API_KEY=sk-your-api-key-here
# Optional: custom base URL for OpenAI-compatible APIs (e.g., self-hosted, DeepSeek, Groq)
# AI_BASE_URL=https://api.openai.com/v1
AI_DEFAULT_MODEL=gpt-4o
AI_FALLBACK_MODEL=gpt-4o-mini
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7
AI_TIMEOUT=60s
# Default AI profile: complex, fast, cheap, or auto
AI_DEFAULT_PROFILE=auto

# Additional AI providers (optional, enables multi-provider routing)
# AI_ANTHROPIC_API_KEY=sk-ant-...
# AI_OPENROUTER_API_KEY=sk-or-...   # OpenRouter — unified access to 200+ models
# AI_GROQ_API_KEY=gsk-...           # Groq — ultra-fast inference (OpenAI-compatible)
# AI_EXTRA_PROVIDERS=name:key:url   # Custom OpenAI-compatible providers (comma-separated)

# RAG (Retrieval Augmented Generation)
# Embedding model for vector search
# AI_EMBEDDING_MODEL=text-embedding-3-small

# AI Response Cache
AI_CACHE_ENABLED=false
AI_CACHE_TTL=5m
# Cache type: "memory" or "redis"
AI_CACHE_TYPE=memory
# Redis connection string (required when AI_CACHE_TYPE=redis)
# AI_REDIS_URL=redis://localhost:6379/0